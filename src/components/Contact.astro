---
import { CheckIcon, CopyIcon } from "@phosphor-icons/react"

export interface Props {
  t: (key: string) => string
}

const { t } = Astro.props
const EMAIL = "franklinmdev@hotmail.com"
---

<section
  id="contact"
  class="page-grid border-rule-strong mt-20 border-t pt-12"
  aria-labelledby="contact-title"
>
  <h2 id="contact-title" class="section-title">{t("contact.title")}</h2>
  <div class="hidden lg:block"></div>
  <div class="mt-2">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <a
        data-email
        class="link font-serif text-[1.5rem] leading-tight break-all sm:text-[2rem]"
        href={`mailto:${EMAIL}`}
        set:text={EMAIL}
      />
      <button
        type="button"
        hidden
        data-copy={EMAIL}
        data-copied-label={t("contact.copied")}
        data-failed-label={t("contact.copy_failed")}
        class="border-rule-strong [@media(hover:hover)]:hover:border-foreground inline-flex min-h-11 items-center gap-1.5 rounded-[2px] border px-3 font-sans text-[0.875rem] transition-colors duration-150"
      >
        <CopyIcon aria-hidden="true" className="size-4" data-icon="copy" />
        <CheckIcon
          aria-hidden="true"
          className="hidden size-4"
          data-icon="done"
        />
        <span data-label>{t("contact.copy")}</span>
      </button>
      <span role="status" class="sr-only" data-copy-status></span>
    </div>
    <p class="text-muted-foreground mt-3 font-sans text-[0.9375rem]">
      {t("contact.lead")}
    </p>
  </div>
</section>

<script>
  // The copy button needs JS, so it stays hidden until this runs. On failure
  // the email is selected so the visitor can copy it by hand.
  function bindCopy() {
    document
      .querySelectorAll<HTMLButtonElement>("[data-copy]")
      .forEach((btn) => {
        if (btn.dataset.bound) return
        btn.dataset.bound = "1"
        btn.hidden = false
        const label = btn.querySelector<HTMLElement>("[data-label]")
        const status =
          btn.parentElement?.querySelector<HTMLElement>("[data-copy-status]")
        const email = btn.parentElement?.querySelector("[data-email]")
        const copyIcon = btn.querySelector("[data-icon=copy]")
        const doneIcon = btn.querySelector("[data-icon=done]")
        const idle = label?.textContent ?? ""
        const mac = /Mac|iPhone|iPad/.test(navigator.userAgent)
        const failed = (btn.dataset.failedLabel ?? idle).replace(
          "Ctrl+C",
          mac ? "Cmd+C" : "Ctrl+C"
        )
        let timer: ReturnType<typeof setTimeout> | undefined

        const show = (text: string, done: boolean) => {
          if (label) label.textContent = text
          if (status) status.textContent = text
          copyIcon?.classList.toggle("hidden", done)
          doneIcon?.classList.toggle("hidden", !done)
          clearTimeout(timer)
          timer = setTimeout(() => {
            if (label) label.textContent = idle
            if (status) status.textContent = ""
            copyIcon?.classList.remove("hidden")
            doneIcon?.classList.add("hidden")
          }, 2500)
        }

        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy ?? "")
            show(btn.dataset.copiedLabel ?? idle, true)
          } catch {
            if (email) window.getSelection()?.selectAllChildren(email)
            show(failed, false)
          }
        })
      })
  }
  bindCopy()
  document.addEventListener("astro:after-swap", bindCopy)
</script>
