---
import { ArrowUpRightIcon, EnvelopeSimpleIcon } from "@phosphor-icons/react"

export interface Props {
  t: (key: string) => string
}

const { t } = Astro.props
---

<section class="page-grid pt-14 pb-4 sm:pt-20 lg:pt-24" aria-labelledby="title">
  <div>
    <h1
      id="title"
      class="text-[2.375rem] leading-[1.06] tracking-[-0.025em] sm:text-[3.25rem] lg:text-[3.75rem]"
    >
      {t("hero.title")}
    </h1>
    <p class="text-muted-foreground mt-5 font-sans text-[0.9375rem]">
      Franklin Martinez. {t("hero.byline")}
    </p>
  </div>
  <aside class="in-margin self-end">
    <p class="sidenote">
      <span class="text-foreground font-medium">{t("hero.note_open")}</span>
    </p>
  </aside>

  <div class="mt-8">
    <p class="measure">
      <span class="font-sans text-[0.9375rem] font-semibold">
        {t("hero.abstract_label")}
      </span>
      {t("hero.abstract")}
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <a href="mailto:franklinmdev@hotmail.com" class="btn btn-primary">
        <EnvelopeSimpleIcon aria-hidden="true" className="size-[18px]" />
        {t("hero.email")}
      </a>
      <a href="https://github.com/franklinmdev" class="btn btn-ghost">
        {t("hero.github")}
        <ArrowUpRightIcon aria-hidden="true" className="size-4" />
      </a>
      <a
        href="https://www.linkedin.com/in/franklin-martinez-0a697a253/"
        class="btn btn-ghost"
      >
        {t("hero.linkedin")}
        <ArrowUpRightIcon aria-hidden="true" className="size-4" />
      </a>
    </div>
  </div>
  <aside class="in-margin mt-8">
    <p class="sidenote">{t("hero.note_figures")}</p>
  </aside>
</section>
