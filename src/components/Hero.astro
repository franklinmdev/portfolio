---
import JustAskFigure from "@/components/JustAskFigure.astro"
import { ArrowUpRightIcon } from "@phosphor-icons/react"

export interface Props {
  t: (key: string) => string
  lang: "en" | "es"
}

const { t, lang } = Astro.props

const links = [
  {
    label: "franklinmdev@hotmail.com",
    href: "mailto:franklinmdev@hotmail.com",
  },
  { label: "GitHub", href: "https://github.com/franklinmdev", external: true },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/franklin-martinez-0a697a253/",
    external: true,
  },
]
---

<section class="page-grid pt-12 pb-2 sm:pt-16 lg:pt-20" aria-labelledby="title">
  <div>
    <h1
      id="title"
      class="text-[2.375rem] leading-[1.06] tracking-[-0.025em] text-balance sm:text-[3.25rem] lg:text-[3.75rem]"
    >
      {t("hero.title")}
    </h1>
    <p class="text-muted-foreground mt-5 font-sans text-[0.9375rem]">
      {t("hero.byline")}
    </p>
    <ul class="mt-2 flex flex-wrap gap-x-5 font-sans text-[0.9375rem]">
      {
        links.map((l) => (
          <li>
            <a
              class="link inline-flex min-h-8 items-center gap-0.5"
              href={l.href}
            >
              {l.label}
              {l.external && (
                <ArrowUpRightIcon aria-hidden="true" className="size-3.5" />
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <JustAskFigure t={t} lang={lang} />
</section>
