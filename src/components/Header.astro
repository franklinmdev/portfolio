---
import { getRelativeLocaleUrl } from "astro:i18n"
import {
  createTranslations,
  getLangFromUrl,
  removeLocalePrefix,
} from "@/i18n/utils"
import type { Language } from "@/i18n/utils"
import { MoonIcon, SunIcon } from "@phosphor-icons/react"

const lang = getLangFromUrl(Astro.url)
const t = createTranslations(lang)

const homeUrl = getRelativeLocaleUrl(lang, "/")
const isHome = removeLocalePrefix(Astro.url.pathname).replace(/\/$/, "") === ""
const anchor = (id: string) => (isHome ? `#${id}` : `${homeUrl}#${id}`)

const otherLang = (lang === "en" ? "es" : "en") as Language
const otherLangUrl = getRelativeLocaleUrl(
  otherLang,
  removeLocalePrefix(Astro.url.pathname)
)

const links = [
  { id: "work", label: t("nav.work") },
  { id: "method", label: t("nav.method") },
  { id: "about", label: t("nav.about") },
  { id: "contact", label: t("nav.contact") },
]
---

<a
  href="#content"
  class="bg-foreground text-background sr-only z-[60] px-3 py-2 font-sans text-sm focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
>
  {t("nav.skip")}
</a>
<header
  class="border-border bg-background/92 sticky top-0 z-50 border-b backdrop-blur-sm"
>
  <div class="page flex h-14 items-center justify-between gap-4">
    <a
      href={homeUrl}
      class="font-serif text-[1.0625rem] font-semibold tracking-tight"
      aria-label={t("nav.home")}
    >
      Franklin Martinez
    </a>
    <nav aria-label={t("nav.label")} class="flex items-center gap-1 sm:gap-2">
      <ul class="hidden items-center gap-1 md:flex">
        {
          links.map((l) => (
            <li>
              <a
                href={anchor(l.id)}
                class="text-muted-foreground hover:text-foreground inline-flex min-h-11 items-center px-2.5 font-sans text-[0.875rem] transition-colors duration-150"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={otherLangUrl}
        hreflang={otherLang}
        lang={otherLang}
        data-lang-switch={otherLang}
        aria-label={t("nav.other_lang")}
        class="text-muted-foreground hover:text-foreground inline-flex min-h-11 min-w-11 items-center justify-center font-sans text-[0.8125rem] font-medium transition-colors duration-150"
      >
        {t("nav.other_lang_short")}
      </a>
      <button
        type="button"
        id="theme-toggle"
        aria-label={t("nav.theme")}
        title={t("nav.theme")}
        class="text-muted-foreground hover:text-foreground inline-flex size-11 items-center justify-center transition-colors duration-150"
      >
        <MoonIcon aria-hidden="true" className="size-[18px] dark:hidden" />
        <SunIcon aria-hidden="true" className="hidden size-[18px] dark:block" />
      </button>
    </nav>
  </div>
  <nav
    aria-label={t("nav.label")}
    class="page border-border border-t md:hidden"
  >
    <ul class="-mx-2 flex">
      {
        links.map((l) => (
          <li>
            <a
              href={anchor(l.id)}
              class="text-muted-foreground hover:text-foreground inline-flex min-h-10 items-center px-2 font-sans text-[0.875rem] transition-colors duration-150"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const BG = { light: "#fbfcfd", dark: "#131418" } as const

  function bind() {
    document.getElementById("theme-toggle")?.addEventListener("click", () => {
      const root = document.documentElement
      const dark = !root.classList.contains("dark")
      root.classList.toggle("dark", dark)
      try {
        localStorage.setItem("theme", dark ? "dark" : "light")
      } catch {
        /* storage unavailable: the choice lasts for this page only */
      }
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute("content", dark ? BG.dark : BG.light)
    })

    document
      .querySelectorAll<HTMLAnchorElement>("[data-lang-switch]")
      .forEach((a) =>
        a.addEventListener("click", () => {
          try {
            localStorage.setItem("preferred-lang", a.dataset.langSwitch ?? "en")
          } catch {
            /* storage unavailable */
          }
        })
      )
  }

  bind()
  document.addEventListener("astro:after-swap", bind)
</script>
