---
import { benchmark, commitUrl } from "@/data/docmatch"

export interface Props {
  t: (key: string) => string
  lang: "en" | "es"
}

const { t, lang } = Astro.props

const usd = (v: number) =>
  new Intl.NumberFormat(lang, {
    style: "currency",
    currency: "USD",
    minimumFractionDigits: 5,
  }).format(v)
---

<figure
  class="span-all mt-8 mb-2"
  data-plotted="false"
  data-autoplot
  aria-labelledby="fig3-caption"
>
  <div class="figure">
    <table class="w-full border-collapse font-sans text-[0.875rem]">
      <thead>
        <tr class="border-rule-strong text-muted-foreground border-b text-left">
          <th class="py-2 pr-3 font-normal">{t("fig3.backend")}</th>
          <th class="py-2 pr-3 text-right font-normal">{t("fig3.f1")}</th>
          <th class="py-2 pr-3 text-right font-normal">{t("fig3.cost")}</th>
          <th class="py-2 text-right font-normal">{t("fig3.commit")}</th>
        </tr>
      </thead>
      <tbody>
        {
          benchmark.map((row, i) => (
            <tr class="border-border border-b">
              <td class="py-2 pr-3">
                {row.backend}
                <span
                  class="text-muted-foreground block text-xs"
                  set:text={row.detail}
                />
              </td>
              <td class="data measured py-2 pr-3 text-right">
                <span
                  class="settle inline-block"
                  style={`transition-delay:${i * 160}ms`}
                >
                  {row.f1.toFixed(3)}
                </span>
              </td>
              <td class="data py-2 pr-3 text-right">
                <span
                  class="settle inline-block"
                  style={`transition-delay:${80 + i * 160}ms`}
                >
                  {usd(row.cost)}
                </span>
              </td>
              <td class="py-2 text-right">
                <a class="link data" href={commitUrl(row.commit)}>
                  {row.commit}
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <figcaption id="fig3-caption" class="caption">
    <b>{t("fig3.label")}.</b>
    {t("fig3.caption")}
  </figcaption>
</figure>
