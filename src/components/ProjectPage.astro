---
import BenchmarkTable from "@/components/BenchmarkTable.astro"
import JustAskFigure from "@/components/JustAskFigure.astro"
import DgiiFigure from "@/components/react/DgiiFigure"
import DocmatchFigure from "@/components/react/DocmatchFigure"
import enStrings from "@/i18n/en.json"
import esStrings from "@/i18n/es.json"
import { createTranslations, getProjectSlug } from "@/i18n/utils"
import { ArrowLeftIcon, ArrowUpRightIcon } from "@phosphor-icons/react"
import { Picture } from "astro:assets"
import type { CollectionEntry } from "astro:content"
import { getRelativeLocaleUrl } from "astro:i18n"

export interface Props {
  project: CollectionEntry<"projects">
  lang: "en" | "es"
}

const { project, lang } = Astro.props
const { data } = project
const slug = getProjectSlug(project.id)
const t = createTranslations(lang)
const s = lang === "es" ? esStrings : enStrings
const home = getRelativeLocaleUrl(lang, "/")

const links = [
  data.liveUrl && { label: t("projects.view_live"), href: data.liveUrl },
  data.githubUrl && { label: t("projects.view_source"), href: data.githubUrl },
  data.npmUrl && { label: "npm", href: data.npmUrl },
].filter((l): l is { label: string; href: string } => Boolean(l))
---

<main id="content" class="page">
  <article class="page-grid pt-10 sm:pt-14">
    <div>
      <a
        href={`${home}#work`}
        class="apparatus hover:text-foreground inline-flex min-h-11 items-center gap-1.5 transition-colors duration-150"
      >
        <ArrowLeftIcon aria-hidden="true" className="size-4" />
        {t("projects.back")}
      </a>
      <h1
        class="mt-4 text-[2.5rem] leading-[1.06] tracking-[-0.025em] sm:text-[3.25rem]"
      >
        {data.title}
      </h1>
      <p class="text-muted-foreground mt-3 font-sans text-[1rem]">
        {data.subtitle}
      </p>
      <p class="measure mt-7">
        <span class="font-sans text-[0.9375rem] font-semibold">
          {t("projects.abstract")}
        </span>
        {data.description}
      </p>
    </div>
    <aside class="in-margin mt-8 lg:mt-[7.5rem]">
      {
        links.length > 0 && (
          <>
            <p class="sidenote text-foreground font-medium">
              {t("projects.links")}
            </p>
            <ul class="sidenote mt-1 space-y-0.5">
              {links.map((l) => (
                <li>
                  <a class="inline-flex items-center gap-0.5" href={l.href}>
                    {l.label}
                    <ArrowUpRightIcon aria-hidden="true" className="size-3" />
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
      <p class="sidenote text-foreground mt-4 font-medium">
        {t("projects.stack")}
      </p>
      <p class="sidenote mt-1">{data.tags.join(", ")}.</p>
    </aside>

    {slug === "justask" && <JustAskFigure t={t} lang={lang} intro={false} />}
    {slug === "docmatch" && <DocmatchFigure client:visible t={s.fig2} />}
    {slug === "dgii-ts" && <DgiiFigure client:visible t={s.fig4} />}
    {
      data.image && (
        <figure class="span-all mt-8 mb-2">
          <div class="border-border border">
            <Picture
              src={data.image}
              formats={["avif", "webp"]}
              widths={[640, 1024, 1600]}
              sizes="(min-width: 1120px) 1120px, 100vw"
              alt=""
              class:list={["h-auto w-full", data.imageDark && "dark:hidden"]}
              loading="eager"
            />
            {data.imageDark && (
              <Picture
                src={data.imageDark}
                formats={["avif", "webp"]}
                widths={[640, 1024, 1600]}
                sizes="(min-width: 1120px) 1120px, 100vw"
                alt=""
                class="hidden h-auto w-full dark:block"
                loading="eager"
              />
            )}
          </div>
          <figcaption class="caption">{s.work.domiprop.caption}</figcaption>
        </figure>
      )
    }

    <div class="prose span-all mt-10">
      <slot name="content" />
    </div>

    {slug === "docmatch" && <BenchmarkTable t={t} lang={lang} />}

    <p class="border-rule-strong mt-14 border-t pt-6">
      <a class="link" href={`${home}#contact`}>{t("projects.contact")}</a>
    </p>
  </article>
</main>
