---
export interface Props {
  t: (key: string) => string
}

const { t } = Astro.props
const [before = "", after = ""] = t("about.outside").split("{link}")
---

<section
  id="about"
  class="page-grid border-rule-strong mt-20 border-t pt-12"
  aria-labelledby="about-title"
>
  <h2 id="about-title" class="section-title">{t("about.title")}</h2>
  <div class="hidden lg:block"></div>
  <div class="mt-4 space-y-5">
    <p>{t("about.p2")}</p>
    <p>
      <span class="font-semibold">{t("about.outside_title")}</span>
      {before}<a
        class="link"
        href="https://www.youtube.com/@arkhelon"
        set:text="Arkhelon"
      />{after}
    </p>
  </div>
</section>
