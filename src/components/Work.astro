---
import domipropDark from "@/assets/projects/domiprop-dashboard-dark.png"
import domipropLight from "@/assets/projects/domiprop-dashboard-light.png"
import MeasuredNote from "@/components/MeasuredNote.astro"
import DgiiFigure from "@/components/react/DgiiFigure"
import DocmatchFigure from "@/components/react/DocmatchFigure"
import { measured } from "@/data/measured"
import enStrings from "@/i18n/en.json"
import esStrings from "@/i18n/es.json"
import { ArrowUpRightIcon } from "@phosphor-icons/react"
import { Picture } from "astro:assets"
import { getRelativeLocaleUrl } from "astro:i18n"

export interface Props {
  t: (key: string) => string
  lang: "en" | "es"
}

const { t, lang } = Astro.props
const s = lang === "es" ? esStrings : enStrings
const deepDive = (slug: string) =>
  getRelativeLocaleUrl(lang, `/projects/${slug}`)

const JUSTASK_LIVE = "https://justask-demo.franklinmdev.workers.dev"

const projects = {
  justask: [
    { label: t("work.live"), href: JUSTASK_LIVE },
    {
      label: t("work.source"),
      href: "https://github.com/franklinmdev/justask",
    },
  ],
  docmatch: [
    {
      label: t("work.source"),
      href: "https://github.com/franklinmdev/docmatch",
    },
  ],
  dgii: [
    { label: "npm", href: "https://www.npmjs.com/package/dgii-ts" },
    {
      label: t("work.source"),
      href: "https://github.com/franklinmdev/dgii-ts",
    },
  ],
}

// Each project's measured note: plain numbers a stranger can judge. Dates and
// commit links for each one live in the deep dives (src/data/measured.ts).
const notes = {
  justask: {
    rows: [
      { value: measured.justask.exact.value, label: t("work.justask.m_exact") },
      { value: measured.justask.held.value, label: t("work.justask.m_held") },
      { value: measured.justask.p95.value, label: t("work.justask.m_p95") },
      { value: measured.justask.cap.value, label: t("work.justask.m_cap") },
    ],
  },
  docmatch: {
    rows: [
      { value: measured.docmatch.p95.value, label: t("work.docmatch.m_p95") },
      { value: measured.docmatch.cost.value, label: t("work.docmatch.m_cost") },
    ],
  },
  dgii: {
    rows: [
      {
        value: measured.dgii.downloads.value,
        label: t("work.dgii.m_downloads"),
      },
      { value: measured.dgii.cedulas.value, label: t("work.dgii.m_cedulas") },
    ],
  },
}

const links = (items: { label: string; href: string }[], slug: string) => [
  ...items,
  { label: t("work.deep_dive"), href: deepDive(slug) },
]
---

<section
  id="work"
  class="page-grid border-rule-strong mt-16 border-t pt-12"
  aria-labelledby="work-title"
>
  <h2 id="work-title" class="section-title">{t("work.title")}</h2>
  <div class="hidden lg:block"></div>

  {/* justask */}
  <div class="mt-4">
    <h3 class="text-[1.625rem] leading-tight">justask</h3>
    <ul class="mt-2 flex flex-wrap gap-x-4 font-sans text-[0.875rem]">
      {
        links(projects.justask, "justask").map((l) => (
          <li>
            <a
              class="link inline-flex min-h-8 items-center gap-0.5"
              href={l.href}
            >
              {l.label}
              {l.href.startsWith("http") && (
                <ArrowUpRightIcon aria-hidden="true" className="size-3.5" />
              )}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-4">{t("work.justask.lead")}</p>
  </div>
  <MeasuredNote class="mt-4 lg:mt-14" {...notes.justask} />

  {/* docmatch */}
  <div class="mt-16">
    <h3 class="text-[1.625rem] leading-tight">docmatch</h3>
    <ul class="mt-2 flex flex-wrap gap-x-4 font-sans text-[0.875rem]">
      {
        links(projects.docmatch, "docmatch").map((l) => (
          <li>
            <a
              class="link inline-flex min-h-8 items-center gap-0.5"
              href={l.href}
            >
              {l.label}
              {l.href.startsWith("http") && (
                <ArrowUpRightIcon aria-hidden="true" className="size-3.5" />
              )}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-4">{t("work.docmatch.lead")}</p>
    <p class="text-muted-foreground mt-3 font-sans text-[0.9375rem]">
      {t("work.docmatch.status")}
    </p>
  </div>
  <MeasuredNote class="mt-4 lg:mt-14" {...notes.docmatch} />
  <DocmatchFigure client:visible t={s.fig2} />

  {/* dgii-ts */}
  <div class="mt-16">
    <h3 class="text-[1.625rem] leading-tight">dgii-ts</h3>
    <ul class="mt-2 flex flex-wrap gap-x-4 font-sans text-[0.875rem]">
      {
        links(projects.dgii, "dgii-ts").map((l) => (
          <li>
            <a
              class="link inline-flex min-h-8 items-center gap-0.5"
              href={l.href}
            >
              {l.label}
              {l.href.startsWith("http") && (
                <ArrowUpRightIcon aria-hidden="true" className="size-3.5" />
              )}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-4">{t("work.dgii.lead")}</p>
    <p class="text-muted-foreground mt-3 font-sans text-[0.9375rem]">
      {t("work.dgii.note_skill")}
      <code class="data text-foreground mt-1 block break-all">
        npx skills add franklinmdev/dgii-ts --skill dgii-ts
      </code>
    </p>
  </div>
  <MeasuredNote class="mt-4 lg:mt-14" {...notes.dgii} />
  <DgiiFigure client:visible t={s.fig4} />

  {/* Also building */}
  <h3 class="mt-16 text-[1.375rem] leading-tight">{t("work.also")}</h3>
  <div class="hidden lg:block"></div>

  <div class="mt-5">
    <h4 class="font-serif text-xl font-semibold">
      <a class="link no-underline" href={deepDive("domiprop")}>DomiProp</a>
    </h4>
    <p class="mt-2">{t("work.domiprop.lead")}</p>
    <ul class="mt-2 flex flex-wrap gap-x-4 font-sans text-[0.875rem]">
      <li>
        <a
          class="link inline-flex min-h-8 items-center gap-0.5"
          href="https://domiprop.com.do"
        >
          domiprop.com.do
          <ArrowUpRightIcon aria-hidden="true" className="size-3.5" />
        </a>
      </li>
      <li>
        <a
          class="link inline-flex min-h-8 items-center"
          href={deepDive("domiprop")}
        >
          {t("work.deep_dive")}
        </a>
      </li>
    </ul>
  </div>
  <figure class="in-margin mt-5 lg:mt-7" aria-labelledby="fig5-caption">
    <div class="border-border border">
      <Picture
        src={domipropLight}
        formats={["avif", "webp"]}
        widths={[480, 720]}
        sizes="(min-width: 1024px) 240px, 100vw"
        alt=""
        class="h-auto w-full dark:hidden"
      />
      <Picture
        src={domipropDark}
        formats={["avif", "webp"]}
        widths={[480, 720]}
        sizes="(min-width: 1024px) 240px, 100vw"
        alt=""
        class="hidden h-auto w-full dark:block"
      />
    </div>
    <figcaption id="fig5-caption" class="caption">
      {t("work.domiprop.caption")}
    </figcaption>
  </figure>

  <div class="mt-10">
    <h4 class="font-serif text-xl font-semibold">brook</h4>
    <p class="mt-2">{t("work.brook.lead")}</p>
    <ul class="mt-2 flex flex-wrap gap-x-4 font-sans text-[0.875rem]">
      <li>
        <a
          class="link inline-flex min-h-8 items-center gap-0.5"
          href="https://brook.franklinmdev.workers.dev"
        >
          {t("work.brook.link")}
          <ArrowUpRightIcon aria-hidden="true" className="size-3.5" />
        </a>
      </li>
    </ul>
  </div>
</section>
