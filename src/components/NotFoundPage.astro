---
import { createTranslations, type Language } from "@/i18n/utils"
import { getRelativeLocaleUrl } from "astro:i18n"

export interface Props {
  lang: Language
}

const { lang } = Astro.props
const t = createTranslations(lang)
const home = getRelativeLocaleUrl(lang, "/")
---

<main id="content" class="page">
  <section class="page-grid pt-20 pb-10 sm:pt-28">
    <div>
      <p class="data measured text-[3.5rem] leading-none sm:text-[4.5rem]">
        404
      </p>
      <h1 class="mt-6 text-[2rem] leading-tight sm:text-[2.5rem]">
        {t("error.404.heading")}
      </h1>
      <p class="mt-4">{t("error.404.description")}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={home} class="btn btn-primary">{t("error.404.home")}</a>
        <a href={`${home}#work`} class="btn btn-ghost">{t("error.404.work")}</a>
      </div>
    </div>
  </section>
</main>
