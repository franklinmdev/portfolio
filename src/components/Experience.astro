---
export interface Props {
  t: (key: string) => string
}

const { t } = Astro.props
const items = ["exp1", "exp2"] as const
---

<section
  id="experience"
  class="page-grid border-rule-strong mt-20 border-t pt-12"
  aria-labelledby="experience-title"
>
  <h2 id="experience-title" class="section-title">
    {t("experience.title")}
  </h2>
  <div class="hidden lg:block"></div>
  {
    items.map((id, i) => (
      <>
        <div class:list={[i === 0 ? "mt-4" : "mt-8"]}>
          <h3 class="font-serif text-xl font-semibold">
            {t(`experience.${id}.title`)}
          </h3>
          <p class="text-muted-foreground mt-0.5 font-sans text-[0.9375rem] lg:hidden">
            {t(`experience.${id}.company`)}, {t(`experience.${id}.date`)}
          </p>
          <p class="mt-2">{t(`experience.${id}.desc`)}</p>
        </div>
        <aside
          class:list={["in-margin hidden lg:block", i === 0 ? "mt-5" : "mt-9"]}
        >
          <p class="sidenote">
            <span class="text-foreground">{t(`experience.${id}.company`)}</span>
            <br />
            {t(`experience.${id}.date`)}
          </p>
        </aside>
      </>
    ))
  }
</section>
